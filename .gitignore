node_modules/
test-results/
playwright-report/
scratchpad-screens/

# Capacitor: mobile/www is a build artifact regenerated by
# scripts/build-mobile-www.js (run `npm run build:mobile` or `npm run
# cap:sync`) — never hand-edited, so it isn't committed. The repo root
# itself is untouched by any of this and keeps serving GitHub Pages exactly
# as before.
mobile/www/
# Xcode per-user/build-machine state — regenerated locally, never useful
# to commit. ios/App itself (the actual project + its public/ copy of the
# web assets) IS committed so the Xcode project builds without Node.
ios/App/xcuserdata/
ios/App/build/
ios/DerivedData/
ios/.build/
